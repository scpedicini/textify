+                assert_eq!(
+                    style.font_weight,
+                    Some(FontWeight::BOLD),
+                    "{case_source:?}: {needle:?}",
+                    case_source = case.source
+                );
+            }
+            for needle in case.normal {
+                let style = style_at(case.source, &styles, needle);
+                assert_eq!(
+                    style.font_style,
+                    None,
+                    "italic leaked in {case_source:?} at {needle:?}",
+                    case_source = case.source
+                );
+                assert_eq!(
+                    style.font_weight,
+                    None,
+                    "bold leaked in {case_source:?} at {needle:?}",
+                    case_source = case.source
+                );
+            }
+        }
+    }
