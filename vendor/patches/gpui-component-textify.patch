+                bold: &["BOLD"],
+                both: &[],
+                normal: &["then plain"],
+            },
+            Case {
+                source: "before ***middle*** after",
+                italic: &[],
+                bold: &[],
+                both: &["middle"],
+                normal: &["before", "after"],
+            },
+            Case {
+                source: "one *first* between _second_ end",
+                italic: &["first", "second"],
+                bold: &[],
+                both: &[],
+                normal: &["one", "between", "end"],
+            },
+            Case {
+                source: "Why isn't this *middle* part italicized and this end part **bold**?",
